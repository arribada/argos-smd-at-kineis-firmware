{
	"name": "STM32",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "../"
	}
  "runArgs": ["--privileged", "-v", "/dev:/dev"],
  "mounts" : [
      {
          "source": "${localEnv:SSH_AUTH_SOCK}",
          "target": "${localEnv:SSH_AUTH_SOCK}",
          "type": "bind"
      }
  ],
  "remoteEnv": {
      "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}",
  }
}    
