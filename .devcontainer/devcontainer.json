{
	// Dev container for the STM32WL55 Kineis firmware. Build / unit-test / edit
	// in a reproducible Linux env. See .devcontainer/README.md.
	"name": "argos-smd-kineis-firmware (STM32WL55)",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	// --privileged + /dev bind lets an ST-LINK USB probe reach the container on
	// a Linux host. On Windows/macOS USB passthrough is unreliable: flash from
	// the host with `make flash*` (J-Link) instead.
	"runArgs": ["--privileged", "-v", "/dev:/dev"],
	"customizations": {
		"vscode": {
			"extensions": [
				"llvm-vs-code-extensions.vscode-clangd",
				"marus25.cortex-debug",
				"ms-python.python"
			],
			"settings": {
				"clangd.arguments": [
					"--background-index",
					"--compile-commands-dir=${workspaceFolder}"
				],
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	// One-time: generate compile_commands.json so clangd resolves includes.
	// Bench build from `make help`; -B forces every compile so bear records them
	// even if the host already left an up-to-date build/. Non-fatal (|| true) so
	// container start never fails. Re-run manually after changing build flags.
	"postCreateCommand": "bear -- make -B BOARD=SMD_STDALONE APP=UW_DOPPLER COMM=UART VERBOSE=0 DEBUG=1 MAC_PRFL=BASIC -j || true"
}